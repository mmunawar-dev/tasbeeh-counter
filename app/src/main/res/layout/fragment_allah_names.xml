<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btn_allah_names_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:text="@string/allahs_names"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:text="@string/allah_names_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <!-- Top Hero Audio Card (Redesigned matching reference UI) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hero_recitation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_170sdp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginHorizontal="@dimen/_8sdp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/new_card"
               >

                <!-- Mosque, archway, lanterns, foliage & calligraphy background artwork -->
<!--                <ImageView-->
<!--                    android:id="@+id/iv_hero_card_bg"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="@dimen/_200sdp"-->
<!--                    android:contentDescription="Allah's 99 Names - Asma-ul-Husna"-->
<!--                    android:src="@drawable/new_card"-->
<!--                    app:layout_constraintBottom_toBottomOf="parent"-->
<!--                    app:layout_constraintDimensionRatio="460:272"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toTopOf="parent" />-->

                <TextView
                    android:id="@+id/btnLearn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:fontFamily="@font/montserrat_family"
                    android:text="Listen - Learn - Reflict"
                    android:textColor="#FFEFA8"
                    android:textSize="@dimen/_16sdp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/frameLayout"
                    app:layout_constraintStart_toStartOf="@+id/frameLayout" />
                <!-- Native Play Pill Button matching reference app screenshot -->
                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_50sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:id="@+id/btn_hero_start"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:background="@drawable/bg_btn_play_allah_names"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"

                        android:paddingHorizontal="@dimen/_8sdp"
                        android:paddingVertical="6dp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        >

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:background="@drawable/bg_btn_play_allah_names"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/_2sdp"
                            android:src="@drawable/ic_play_arrow_white_24" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_6sdp"
                                android:fontFamily="@font/montserrat_family"
                                android:text="Play &amp; Start Listening"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Player Controls (shown over card when audio is playing) -->
                    <LinearLayout
                        android:id="@+id/ll_audio_player_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_btn_play_allah_names"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pb_hero_audio_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:visibility="gone"
                            app:indicatorColor="#E2C47E"
                            app:indicatorDirectionLinear="leftToRight"
                            app:trackColor="#40FFFFFF"
                            app:trackCornerRadius="@dimen/_6sdp"
                            app:trackThickness="@dimen/_8sdp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_hero_current_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/montserrat_family"
                                android:text="00:00"
                                android:textColor="#E0F2E9"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_hero_total_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/montserrat_family"
                                android:text="03:45"
                                android:textColor="#E0F2E9"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:layout_marginBottom="@dimen/_4sdp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_hero_toggle"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:backgroundTint="#0A5C38"
                                android:fontFamily="@font/montserrat_family"
                                android:text="@string/pause"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="19dp"
                                app:strokeColor="#E2C47E"
                                app:strokeWidth="0.5dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_hero_stop"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/montserrat_family"
                                android:text="@string/stop"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="19dp"
                                app:strokeColor="#80FFFFFF"
                                app:strokeWidth="0.5dp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_names_search"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:hint="@string/search_names_hint"
            app:boxBackgroundColor="@color/surface_light"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/card_allah_names_start"
            app:boxStrokeWidth="0dp"
            android:outlineProvider="none"
            app:endIconMode="clear_text"
            app:startIconDrawable="@android:drawable/ic_menu_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_names_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:inputType="text"
                android:maxLines="1"

                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Names List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_allah_names"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="40dp" />

    </LinearLayout>

</LinearLayout>
