<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_screen_dark"
    tools:context=".ui.fragments.PremiumFragment">

    <!-- Scrollable Content -->

    <!-- ═══════════════════════════════════════════
         SCROLLABLE CONTENT
    ═══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_premium"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_cta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/premium_screen_bg"
            android:paddingBottom="10dp">

            <!-- 1. Hero Image Header (premium_top.png) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView"
                android:layout_width="0dp"
                android:layout_height="@dimen/_215sdp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/premium_media"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSizeTop" />

            <!-- 2. Smooth Bottom Gradient Shade (Seamlessly blends image into screen background) -->


            <!-- 3. Close Circular Button (Top Right) -->
            <ImageView
                android:id="@+id/btn_premium_close"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_margin="@dimen/_18sdp"
                android:background="@drawable/bg_premium_close_circle"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/ic_premium_close"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 4. "DEEN PREMIUM" Pill Badge -->
            <TextView
                android:id="@+id/tvDeenBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_6sdp"
                android:background="@drawable/bg_premium_deen_badge"
                android:fontFamily="@font/montserrat_family"
                android:letterSpacing="0.12"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="DEEN PREMIUM"
                android:textColor="@color/gold_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 5. Headline ("Elevate Your Daily Worship") -->
            <LinearLayout
                android:id="@+id/linearLayout4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_8sdp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@+id/textView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_family"
                    android:text="Elevate Your "
                    android:textColor="@color/premium_text_hero"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_family"
                    android:text="Daily Worship"
                    android:textColor="@color/gold_accent"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. Hero Subtitle -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Uninterrupted prayer times and accurate qibla"
                android:textColor="@color/premium_text_subtitle"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/imageView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 7. Features Row (Ad-Free & Lightning-Fast Access) -->
            <LinearLayout
                android:id="@+id/linearLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                app:layout_constraintBottom_toTopOf="@id/cardMonthly"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView">

                <!-- Feature 1: Ad-Free Experience -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_premium_feat_icon_circle">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Ad free"
                            android:src="@drawable/ic_feat_shield"
                            app:tint="@color/gold_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_family"
                        android:gravity="center"
                        android:text="Ad-Free Experience"
                        android:textColor="@color/premium_text_feature"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="0.8dp"
                    android:layout_height="46dp"
                    android:background="@color/premium_divider" />

                <!-- Feature 2: Lightning-Fast Access -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_premium_feat_icon_circle">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="Fast access"
                            android:src="@drawable/ic_feat_lightning"
                            app:tint="@color/gold_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montserrat_family"
                        android:gravity="center"
                        android:text="Lightning-Fast Access"
                        android:textColor="@color/premium_text_feature"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- 8. Monthly Plan Card -->
            <LinearLayout
                android:id="@+id/cardMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_premium_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toTopOf="@id/frameLayoutLifeTime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

                <!-- Radio Indicator -->
                <ImageView
                    android:id="@+id/iv_radio_weekly"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Select monthly plan"
                    android:src="@drawable/ic_radio_circle_empty" />

                <!-- Title & Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_family"
                        android:text="Monthly Plan"
                        android:textColor="@color/premium_text_card_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/montserrat_family"
                        android:text="One month payment"
                        android:textColor="@color/premium_text_card_subtitle"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_family"
                        android:text="1,550.00 PKR"
                        android:textColor="@color/premium_text_card_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/montserrat_family"
                        android:text="/ month"
                        android:textColor="@color/premium_text_card_subtitle"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 9. Lifetime Plan Card Container (with RECOMMENDED Badge) -->
            <FrameLayout
                android:id="@+id/frameLayoutLifeTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMonthly">

                <!-- Card Body -->
                <LinearLayout
                    android:id="@+id/card_plan_yearly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_premium_card_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/iv_radio_yearly"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Select lifetime plan"
                        android:src="@drawable/ic_radio_selected_gold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_family"
                            android:text="Lifetime Plan"
                            android:textColor="@color/premium_text_card_title"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/montserrat_family"
                            android:text="One time payment"
                            android:textColor="@color/premium_text_card_subtitle"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_family"
                            android:text="5,555 PKR"
                            android:textColor="@color/gold_accent"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/montserrat_family"
                            android:text="/ once"
                            android:textColor="@color/gold_accent"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- RECOMMENDED Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_recommended_badge"
                    android:fontFamily="@font/montserrat_family"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3.5dp"
                    android:text="RECOMMENDED"
                    android:textColor="@color/premium_recommended_badge_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/txt_plan_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_5sdp"
                android:text="you will be charged once per month. subscription will be auto renue from the date of purchas. you can cancel at any time."
                android:textAlignment="textStart"
                android:textColor="@color/premium_text_feature"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintTop_toBottomOf="@id/frameLayoutLifeTime"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/frameLayoutLifeTime"
                app:layout_constraintStart_toStartOf="@+id/frameLayoutLifeTime" />



        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════
         BOTTOM CTA PINNED CONTAINER
    ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_bottom_cta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/premium_screen_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Continue CTA Button -->
        <LinearLayout
            android:id="@+id/btn_premium_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_premium_cta_gold"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:background="@drawable/bg_circle_gold"
                android:contentDescription="Crown"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/premium"
                app:tint="@color/gold_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:text="Continue"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Go"
                android:src="@drawable/ic_arrow_right_white" />

        </LinearLayout>

        <!-- Terms & Privacy Links -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTermCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/montserrat_family"
                android:padding="4dp"
                android:text="Terms &amp; Conditions"
                android:textColor="@color/premium_footer_link"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/premium_divider"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_terms_conditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/montserrat_family"
                android:padding="4dp"
                android:text="Privacy Policy"
                android:textColor="@color/premium_footer_link"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
