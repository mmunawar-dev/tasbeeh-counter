<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Hero Image with bottom rounded corners (28dp) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_onboarding_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomRounded28" />

    <!-- Text & Pill Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <!-- Subtitle Pill -->
        <TextView
            android:id="@+id/tv_onboarding_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_gold"
            android:fontFamily="@font/montserrat_family"
            android:letterSpacing="0.04"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="ACCURATE &amp; LOCALIZED"
            android:textColor="@color/ochre_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_onboarding_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/montserrat_family"
            android:gravity="center"
            android:text="Know Prayer Times"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_onboarding_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/montserrat_family"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="6dp"
            android:text="Accurate daily prayer timetable calculated precisely for your location, sun position, and fiqh preferences."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
