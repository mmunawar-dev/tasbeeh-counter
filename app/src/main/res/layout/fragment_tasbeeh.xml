<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sk_background"
    android:orientation="vertical">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:id="@+id/tasbeeh_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sk_surface"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btn_tasbeeh_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="@color/sk_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Sk.Text.TitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Digital Tasbeeh"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tasbeeh_subtitle"
                    style="@style/Sk.Text.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_tasbeeh_sound"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tasbeeh feedback mode"
                android:src="@drawable/ic_sk_volume_up" />

            <ImageButton
                android:id="@+id/btn_tasbeeh_haptic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Haptic feedback"
                android:src="@drawable/ic_sk_vibration"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_tasbeeh_dhikr_list"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Select Dhikr"
                android:src="@drawable/ic_sk_list"
                app:tint="@color/sk_on_surface" />

            <ImageButton
                android:id="@+id/btn_tasbeeh_reset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reset count"
                android:src="@drawable/ic_sk_refresh"
                app:tint="@color/sk_on_surface" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Style switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/Sk.Text.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.09"
                    android:text="TASBEEH MODE"
                    android:textColor="@color/sk_primary"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ll_tasbeeh_styles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Active dhikr card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_sk_dhikr_card"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_dhikr_badge"
                        style="@style/Sk.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_sk_dhikr_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="#0F766E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/btn_dhikr_change"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sk_edit"
                            app:tint="@color/sk_primary" />

                        <TextView
                            style="@style/Sk.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Change"
                            android:textColor="@color/sk_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_dhikr_target"
                        style="@style/Sk.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/sk_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <TextView
                    android:id="@+id/tv_dhikr_arabic"
                    style="@style/Sk.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="10sp"
                    android:textColor="@color/sk_dhikr_arabic"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dhikr_translit"
                    style="@style/Sk.Text.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/sk_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dhikr_translation"
                    style="@style/Sk.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

                <ProgressBar
                    android:id="@+id/pb_dhikr_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_sk_tasbeeh" />
            </LinearLayout>

            <!-- Target completion celebration banner -->
            <LinearLayout
                android:id="@+id/ll_tasbeeh_celebration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_sk_celebration"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sk_celebration"
                    app:tint="#047857" />

                <TextView
                    android:id="@+id/tv_tasbeeh_celebration"
                    style="@style/Sk.Text.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#065F46"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Main interactive visual (beads / hand clicker / balloons) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_tasbeeh_visual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Sk.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Tap bead, button, or balloon to increment Dhikr"
                android:textColor="@color/sk_on_surface_variant_80"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>