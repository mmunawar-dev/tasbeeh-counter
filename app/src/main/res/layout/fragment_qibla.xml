<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/qibla_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sk_background"
    android:orientation="vertical"
    tools:context=".ui.fragments.QiblaFragment">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">


        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center"
            android:padding="@dimen/_5sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/sk_on_surface" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Sk.Text.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qibla_direction"
                android:textColor="@color/sk_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Sk.Text.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/qibla_subtitle_full"
                android:textColor="@color/sk_on_surface_variant_70"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">

        <!-- 1. City & distance pill -->
        <LinearLayout
            android:id="@+id/layoutLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_sk_pill_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toTopOf="@+id/compose_qibla_dial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sk_location_on"
                app:tint="@color/sk_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_qibla_city"
                    style="@style/Sk.Text.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sk_on_surface"
                    android:textStyle="bold"
                    tools:text="Islamabad, Pakistan" />

                <TextView
                    android:id="@+id/tv_qibla_bearing"
                    style="@style/Sk.Text.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sk_on_surface_variant_70"
                    android:textSize="11sp"
                    tools:text="Bearing: 256° from North" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_qibla_distance"
                    style="@style/Sk.Text.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sk_badge_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/sk_on_secondary_container"
                    android:textStyle="bold"
                    tools:text="3628 km" />

                <LinearLayout
                    android:id="@+id/btn_qibla_change_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_qibla_change_location"
                        style="@style/Sk.Text.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change_location"
                        android:textColor="@color/sk_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Compass Dial (Compose Canvas) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_qibla_dial"
            android:layout_width="@dimen/_220sdp"
            android:layout_height="@dimen/_220sdp"

            android:layout_marginTop="@dimen/_10sdp"
            android:contentDescription="qibla_compass_dial"
            app:layout_constraintEnd_toEndOf="@+id/layoutLocation"
            app:layout_constraintStart_toStartOf="@+id/layoutLocation"
            app:layout_constraintTop_toBottomOf="@id/layoutLocation" />

        <!-- 3. Active Style Header (Title + ✓ Active pill badge) -->
      <!--  <LinearLayout
            android:id="@+id/ll_selected_style_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/compose_qibla_dial">

            <TextView
                android:id="@+id/tv_selected_style_name"
                style="@style/Sk.Text.TitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sk_on_surface"
                android:textSize="15.5sp"
                android:textStyle="bold"
                tools:text="Classic Gold" />

            <TextView
                android:id="@+id/tv_style_active_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_active_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/style_active"
                android:textColor="#167B51"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>-->

        <!-- 4. Compass Theme Preview Selector Card -->
        <FrameLayout
            android:id="@+id/card_compass_styles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:background="@drawable/bg_compass_carousel_card"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:paddingVertical="@dimen/_4sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/compose_qibla_dial">

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_compass_styles"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_38sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>

        <!-- 5. Tap to preview helper text -->

        <!-- 6. Status & calibration -->
        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/ll_qibla_aligned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sk_status_aligned"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sk_check_circle"
                    app:tint="#167B51" />

                <TextView
                    style="@style/Sk.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.04"
                    android:text="@string/qibla_aligned_full"
                    android:textColor="#167B51"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_qibla_rotate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sk_status_pending"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sk_explore"
                    app:tint="@color/sk_primary" />

                <TextView
                    android:id="@+id/tv_qibla_rotate"
                    style="@style/Sk.Text.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/sk_on_surface"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/Sk.Text.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/qibla_calibrating"
                android:textColor="@color/sk_on_surface_variant_70"
                android:textSize="10.5sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
