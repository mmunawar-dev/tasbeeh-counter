<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_screen_dark"
    tools:context=".ui.activities.PremiumActivity">

    <!-- ✕ Close Circular Button (Top Right) -->
    <ImageView
        android:id="@+id/btn_premium_close"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_premium_close_circle"
        android:clickable="true"
        android:contentDescription="Close"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="@dimen/_3sdp"
        android:src="@drawable/ic_premium_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════
         SCROLLABLE CONTENT (Landscape 2-Column Split)
    ═══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_premium"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/premium_screen_bg"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <!-- LEFT COLUMN: Hero Art, Badges, Title & Feature Highlights -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="42"
                android:gravity="center_horizontal"
                android:orientation="vertical">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_180sdp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/premium_media"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSizeTop" />


                        <TextView
                            android:id="@+id/tvDeenBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_premium_deen_badge"
                            android:fontFamily="@font/montserrat_family"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="@dimen/_10sdp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="DEEN PREMIUM"
                            android:textColor="@color/gold_accent"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <LinearLayout
                            android:id="@+id/linearLayout4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="@+id/imageView"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_family"
                                android:text="Elevate Your "
                                android:paddingVertical="@dimen/_5sdp"
                                android:textColor="@color/premium_text_hero"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_family"
                                android:text="Daily Worship"
                                android:paddingVertical="@dimen/_5sdp"
                                android:textColor="@color/gold_accent"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>





                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Uninterrupted prayer times and accurate qibla"
                    android:textColor="@color/premium_text_subtitle"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Features Row (2 items side by side) -->
                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_premium_feat_icon_circle">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Ad free"
                                android:src="@drawable/ic_feat_shield"
                                app:tint="@color/gold_accent" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/montserrat_family"
                            android:gravity="center"
                            android:text="Ad-Free"
                            android:textColor="@color/premium_text_feature"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0.8dp"
                        android:layout_height="32dp"
                        android:background="@color/premium_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_premium_feat_icon_circle">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Fast access"
                                android:src="@drawable/ic_feat_lightning"
                                app:tint="@color/gold_accent" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/montserrat_family"
                            android:gravity="center"
                            android:text="Fast Access"
                            android:textColor="@color/premium_text_feature"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- RIGHT COLUMN: Subscription Plans, CTA & Disclaimers -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="58"
                android:orientation="vertical">

                <!-- Monthly Plan Card -->
                <LinearLayout
                    android:id="@+id/cardMonthly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_premium_card_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/iv_radio_weekly"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Select monthly plan"
                        android:src="@drawable/ic_radio_circle_empty" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_family"
                            android:text="Monthly Plan"
                            android:textColor="@color/premium_text_card_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/montserrat_family"
                            android:text="One month payment"
                            android:textColor="@color/premium_text_card_subtitle"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_family"
                            android:text="1,550.00 PKR"
                            android:textColor="@color/premium_text_card_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_family"
                            android:text="/ month"
                            android:textColor="@color/premium_text_card_subtitle"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Lifetime Plan Card Container -->
                <FrameLayout
                    android:id="@+id/frameLayoutLifeTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/card_plan_yearly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_premium_card_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:id="@+id/iv_radio_yearly"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Select lifetime plan"
                            android:src="@drawable/ic_radio_selected_gold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_family"
                                android:text="Lifetime Plan"
                                android:textColor="@color/premium_text_card_title"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat_family"
                                android:text="One time payment"
                                android:textColor="@color/premium_text_card_subtitle"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_family"
                                android:text="5,555 PKR"
                                android:textColor="@color/gold_accent"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_family"
                                android:text="/ once"
                                android:textColor="@color/gold_accent"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_recommended_badge"
                        android:fontFamily="@font/montserrat_family"
                        android:letterSpacing="0.1"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="RECOMMENDED"
                        android:textColor="@color/premium_recommended_badge_text"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txt_plan_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="You will be charged once. Subscription will auto-renew. Cancel at any time."
                    android:textColor="@color/premium_text_feature"
                    android:textSize="10sp" />

                <!-- Continue Button & Footer Links Container -->
                <LinearLayout
                    android:id="@+id/ll_bottom_cta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btn_premium_continue"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_premium_cta_gold"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_circle_gold"
                            android:contentDescription="Crown"
                            android:padding="4dp"
                            android:src="@drawable/premium"
                            app:tint="@color/gold_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_family"
                            android:gravity="center"
                            android:text="Continue"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Go"
                            android:src="@drawable/ic_arrow_right_white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTermCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/montserrat_family"
                            android:padding="4dp"
                            android:text="Terms &amp; Conditions"
                            android:textColor="@color/premium_footer_link"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:text="•"
                            android:textColor="@color/premium_divider"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btn_terms_conditions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/montserrat_family"
                            android:padding="4dp"
                            android:text="Privacy Policy"
                            android:textColor="@color/premium_footer_link"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
