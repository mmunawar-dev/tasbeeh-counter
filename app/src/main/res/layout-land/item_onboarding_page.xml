<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Hero Image (Left Column in Landscape) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_onboarding_hero"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded16" />

    <!-- Text & Pill Section (Right Column in Landscape) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <!-- Subtitle Pill -->
            <TextView
                android:id="@+id/tv_onboarding_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_gold"
                android:fontFamily="@font/montserrat_family"
                android:letterSpacing="0.04"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="ACCURATE &amp; LOCALIZED"
                android:textColor="@color/ochre_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_onboarding_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:text="Know Prayer Times"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tv_onboarding_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="4dp"
                android:text="Accurate daily prayer timetable calculated precisely for your location, sun position, and fiqh preferences."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
