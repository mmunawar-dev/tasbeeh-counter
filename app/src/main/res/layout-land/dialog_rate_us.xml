<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_rate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:text="@string/rate_dialog_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_rate_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/rate_dialog_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 5 Stars Row -->
            <LinearLayout
                android:id="@+id/ll_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_star_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Star 1"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/iv_star_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Star 2"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/iv_star_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Star 3"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_star_unfilled" />

                <ImageView
                    android:id="@+id/iv_star_4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Star 4"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_star_unfilled" />

                <ImageView
                    android:id="@+id/iv_star_5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Star 5"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_star_unfilled" />

            </LinearLayout>

            <!-- Buttons Row (Cancel, Rate) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_rate_cancel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_cancel_dialog"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center"
                    android:text="@string/cancel"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_rate_submit"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_rate_dialog"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center"
                    android:text="@string/rate_dialog_btn_rate"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</com.google.android.material.card.MaterialCardView>
