<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the Compose default (system) typography used by the Qibla / Tasbeeh screens -->
    <style name="Sk.Text" parent="">
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/sk_on_surface</item>
    </style>
    <style name="Sk.Text.TitleLarge">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Sk.Text.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.009</item>
    </style>
    <style name="Sk.Text.TitleSmall">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Sk.Text.BodyMedium">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Sk.Text.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/sk_on_surface_variant</item>
    </style>
    <style name="Sk.Text.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>
</resources>