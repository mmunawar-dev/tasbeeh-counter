            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/citySelectFragment"
        android:name="com.example.ui.fragments.CitySelectFragment"
        android:label="Select City"
        tools:layout="@layout/fragment_city_select" />

    <fragment
        android:id="@+id/prayerSettingsFragment"
        android:name="com.example.ui.fragments.PrayerSettingsFragment"
        android:label="Prayer Settings"
        tools:layout="@layout/fragment_prayer_settings">
        <action
            android:id="@+id/action_prayerSettings_to_calendar"
            app:destination="@id/calendarFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_prayerSettings_to_fiqhSettings"
            app:destination="@id/fiqhSelectFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.ui.fragments.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/allahNamesFragment"
        android:name="com.example.ui.fragments.AllahNamesFragment"
        android:label="Allah's Names"
        tools:layout="@layout/fragment_allah_names" />

    <fragment
        android:id="@+id/tasbeehFragment"
        android:name="com.example.ui.fragments.TasbeehFragment"
        android:label="Tasbeeh Counter"
        tools:layout="@layout/fragment_tasbeeh" />

    <fragment
        android:id="@+id/qiblaFragment"
        android:name="com.example.ui.fragments.QiblaFragment"
        android:label="Qibla Compass"
        tools:layout="@layout/fragment_qibla" />

    <fragment
        android:id="@+id/duaCategoriesFragment"
        android:name="com.example.ui.fragments.DuaCategoriesFragment"
        android:label="Dua Categories"
        tools:layout="@layout/fragment_dua_categories">
        <action
            android:id="@+id/action_duaCategories_to_duaList"
            app:destination="@id/duaListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/duaListFragment"
        android:name="com.example.ui.fragments.DuaListFragment"
        android:label="Duas"
        tools:layout="@layout/fragment_dua_list">
        <action
            android:id="@+id/action_duaList_to_duaDetail"
