            app:destination="@id/prayerSettingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_appSettings_to_premium"
            app:destination="@id/premiumFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/languageSelectFragment"
        android:name="com.example.ui.fragments.LanguageSelectFragment"
        android:label="Select Language"
        tools:layout="@layout/fragment_language_select" />

    <fragment
        android:id="@+id/fiqhSelectFragment"
        android:name="com.example.ui.fragments.FiqhSelectFragment"
        android:label="Fiqh Settings"
        tools:layout="@layout/fragment_fiqh_select" />

    <fragment
        android:id="@+id/premiumFragment"
        android:name="com.example.ui.fragments.PremiumFragment"
        android:label="Sakinah Plus"
        tools:layout="@layout/fragment_premium" />

</navigation>
